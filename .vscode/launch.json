    "version": "0.2.0",
    "configurations": [

        {
            "name": "Python Debugger: Module",
            "type": "debugpy",
            "request": "launch",
            "module": "mllam_data_prep",
            "args": ["data/datastore.yaml", "--output", "data/datastore.zarr"],
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false
        },
        {
            "name": "Python Debugger: graph",
            "type": "debugpy",
            "request": "launch",
            "module": "neural_lam.create_graph",
            "args": ["--config_path", "data/config.yaml", "--name", "hierarchical_4lvl", "--levels", "4", "--hierarchical"],
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false
        }
        {
            "name": "Python Debugger: weather-model-graphs",
            "type": "debugpy",
            "request": "launch",
            "module": "neural_lam.create_graph",
            "args": ["--config_path", "data/config.yaml", "--name", "hierarchical_4lvl", "--levels", "4", "--hierarchical"],
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false
        }
    ]
}