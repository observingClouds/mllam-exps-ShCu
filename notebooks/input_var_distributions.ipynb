   "source": [
    "import xarray as xr\n",
    "import scipy\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "ds = xr.open_dataset(\"/home/has/data/sources/icon/ICON312_v1.0.0.zarr\")\n",
    "\n",
    "for var in ds.data_vars:\n",
    "    plt.figure()\n",
    "    ds[var].isel(time=400).plot.hist(bins=50);\n",
    "    plt.title(var)"
   ]
